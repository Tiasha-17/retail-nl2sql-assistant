# Default: run the installed local Ollama model with no paid API key.
RETAIL_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Optional OpenAI configuration. Set RETAIL_LLM_PROVIDER=openai to use it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Optional runtime tuning.
RETAIL_DATABASE_PATH=data/retail_star_schema.db
RETAIL_MAX_ROWS=100
RETAIL_QUERY_TIMEOUT_MS=2000
RETAIL_SCHEMA_SAMPLE_ROWS=2
RETAIL_LLM_TIMEOUT_SECONDS=120
